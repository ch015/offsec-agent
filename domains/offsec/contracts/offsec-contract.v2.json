{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "nunchi.offsec.assessment",
  "version": "2.0.0",
  "executionMode": "host-bounded-workers",
  "leadRole": "reporter",
  "forbiddenModelTools": [
    "Agent"
  ],
  "limits": {
    "maxBudgetUsd": null,
    "maxSubagentDepth": 1
  },
  "workUnitPolicy": {
    "minimumSourceFiles": 50,
    "maximumWorkUnits": 128,
    "maximumConcurrency": 16,
    "maxContextFilesPerUnit": 75
  },
  "isolation": {
    "settingSources": [],
    "strictMcpConfig": true,
    "disableAutoMemory": true,
    "inheritParentSecrets": false,
    "sandboxRequired": true,
    "networkDefaultDeny": true,
    "permissionMode": "dontAsk",
    "reportGate": "on"
  },
  "roles": {
    "analyzer": {
      "agentFile": "contracts/roles/analyzer.md",
      "description": "8차원 보안 아키텍처 진단과 증거 기반 취약점 후보 생성을 담당하는 분석 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash",
        "Write",
        "mcp__nunchi__submit_finding"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "reviewer": {
      "agentFile": "contracts/roles/reviewer.md",
      "description": "분석 산출물의 모든 finding을 실제 코드와 대조하여 검수·보정하는 검토 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write",
        "mcp__nunchi__submit_finding"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "evaluator": {
      "agentFile": "contracts/roles/evaluator.md",
      "description": "검토된 취약점 목록을 기반으로 커버리지·심각도·전체 보안 수준을 객관적으로 평가하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "reporter": {
      "agentFile": "contracts/roles/reporter.md",
      "description": "평가 결과를 기반으로 최종 보안 보고서 초안을 작성하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    }
  },
  "phases": [
    {
      "id": "recon",
      "role": "host",
      "requires": [],
      "controller": "host",
      "requiredMethodFiles": [],
      "requiredArtifacts": [
        "00_recon.json",
        "00_dependency_graph.json"
      ],
      "optionalArtifacts": [
        "00_host_recon.json"
      ]
    },
    {
      "id": "plan",
      "role": "host",
      "requires": [
        "recon"
      ],
      "controller": "host",
      "requiredMethodFiles": [],
      "requiredArtifacts": [
        "01_analysis_plan.json"
      ],
      "optionalArtifacts": []
    },
    {
      "id": "analyze",
      "role": "analyzer",
      "requires": [
        "plan"
      ],
      "requiredMethodFiles": [
        "methods/analyze.md"
      ],
      "requiredArtifacts": [
        "02_analysis_result.md",
        "02_findings_index.yaml"
      ],
      "optionalArtifacts": [
        "02_analysis_handoff.yaml"
      ]
    },
    {
      "id": "review",
      "role": "reviewer",
      "requires": [
        "analyze"
      ],
      "requiredMethodFiles": [
        "methods/review.md",
        "skills/ch015/common/evidence-verification.md"
      ],
      "requiredArtifacts": [
        "03_review_result.json"
      ],
      "optionalArtifacts": []
    },
    {
      "id": "evaluate",
      "role": "evaluator",
      "requires": [
        "review"
      ],
      "requiredMethodFiles": [
        "methods/evaluate.md"
      ],
      "requiredArtifacts": [
        "04_evaluation.json",
        "04_evaluation_classification.yaml"
      ],
      "optionalArtifacts": []
    },
    {
      "id": "report",
      "role": "reporter",
      "requires": [
        "evaluate"
      ],
      "requiredMethodFiles": [
        "methods/report.v2.md"
      ],
      "requiredArtifacts": [
        "07_security_report.draft.md"
      ],
      "optionalArtifacts": []
    }
  ],
  "hostExecution": {
    "kind": "sealed-work-set",
    "entrypoint": "assess",
    "workerPhases": [
      "analyze"
    ],
    "maximumWorkUnits": 128,
    "maximumConcurrency": 16,
    "completionBarrier": "all-settled-all-required",
    "directPhaseExecution": "forbidden",
    "workUnitArtifacts": {
      "comment": "analyze phase의 per-unit 산출물은 work-units/<unitKey>/ 하위에 생성된다. 호스트가 00_work_unit_results.json으로 집계하며, review phase에는 집계된 결과와 standard-findings 원장이 전달된다.",
      "perUnitDir": "work-units/{unitKey}",
      "aggregationArtifact": "00_work_unit_results.json"
    }
  },
  "publication": {
    "phase": "report",
    "draftArtifact": "07_security_report.draft.md",
    "finalArtifact": "07_security_report.md"
  },
  "schemaResources": {
    "phaseResultSchema": "contracts/offsec-phase-result-schema.v2.json",
    "findingSchema": "contracts/offsec-finding-schema.v2.json"
  },

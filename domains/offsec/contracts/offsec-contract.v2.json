  },
  "phaseResultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contractVersion",
      "phase",
      "role",
      "status",
      "artifacts",
      "summary",
      "metrics",
      "unresolved"
    ],
    "properties": {
      "contractVersion": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "blocked"
        ]
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "summary": {
        "type": "string"
      },
      "metrics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingCount"
        ],
        "properties": {
          "findingCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "workUnit": {
        "description": "work-unit identity 메타데이터. 호스트가 unit 결과를 올바른 plan/source에 라우팅하기 위한 식별자이며, 외부 변조 방어 목적이 아니다.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workUnitKey",
          "workPlanSha256",
          "assignedSourceSha256"
        ],
        "properties": {
          "workUnitKey": {
            "type": "string",
            "pattern": "^unit-[a-f0-9]{16}$"
          },
          "workPlanSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assignedSourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "findingSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "contractVersion",
      "phase",
      "role",
      "round",
      "title",
      "verdict",
      "severity",
      "evidenceClass",
      "reachability",
      "preconditions",
      "severityRationale",
      "evidence",
      "confidence",
      "impact",
      "remediation",
      "standards",
      "unresolved"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
      },
      "contractVersion": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "round": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "verdict": {
        "type": "string",
        "enum": [
          "supported",
          "unsupported",
          "abstain",
          "escalate"
        ]
      },
      "severity": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW",
          "INFO"
        ]
      },
      "evidenceClass": {
        "type": "string",
        "enum": [
          "data-flow",
          "configuration",
          "access-control",
          "runtime",
          "documentation"
        ]
      },
      "reachability": {
        "type": "string",
        "enum": [
          "confirmed",
          "plausible",
          "unconfirmed",
          "not-applicable"
        ]
      },
      "preconditions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "severityRationale": {
        "type": "string",
        "minLength": 1
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "impact": {
        "type": "string"
      },
      "remediation": {
        "type": "string"
      },
      "standards": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "lineStart",
            "lineEnd",
            "quote"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "lineStart": {
              "type": "integer",
              "minimum": 1
            },
            "lineEnd": {
              "type": "integer",
              "minimum": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "revises": {
        "type": "string",
        "pattern": "^F-[0-9]{12}$"
      },
      "fingerprint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "path",
          "anchor",
          "ordinal",
          "span",
          "evidence",
          "weakness",
          "digest"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "enum": [
              "fp1"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^([a-f0-9]{64})?$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "span": {
            "type": "string",
            "pattern": "^([a-f0-9]{64})?$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weakness": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },

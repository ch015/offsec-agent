  "phaseResultSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contractVersion",
      "phase",
      "role",
      "status",
      "artifacts",
      "summary",
      "metrics",
      "unresolved"
    ],
    "properties": {
      "contractVersion": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "blocked"
        ]
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "summary": {
        "type": "string"
      },
      "metrics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingCount",
          "objectionCount"
        ],
        "properties": {
          "findingCount": {
            "type": "integer",
            "minimum": 0
          },
          "objectionCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "workUnit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workUnitKey",
          "workPlanSha256",
          "assignedSourceSha256"
        ],
        "properties": {
          "workUnitKey": {
            "type": "string",
            "pattern": "^unit-[a-f0-9]{16}$"
          },
          "workPlanSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assignedSourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "findingSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "contractVersion",
      "phase",
      "role",
      "round",
      "title",
      "verdict",
      "severity",
      "evidenceClass",
      "reachability",
      "preconditions",
      "severityRationale",
      "evidence",
      "confidence",
      "impact",
      "remediation",
      "standards",
      "unresolved"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
      },
      "contractVersion": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "round": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "verdict": {
        "type": "string",
        "enum": [
          "supported",
          "unsupported",
          "abstain",
          "escalate"
        ]
      },
      "severity": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW",
          "INFO"
        ]
      },
      "evidenceClass": {
        "type": "string",
        "enum": [
          "data-flow",
          "configuration",
          "access-control",
          "runtime",
          "documentation"
        ]
      },
      "reachability": {
        "type": "string",
        "enum": [
          "confirmed",
          "plausible",
          "unconfirmed",
          "not-applicable"
        ]
      },
      "preconditions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "severityRationale": {
        "type": "string",
        "minLength": 1
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "impact": {
        "type": "string"
      },
      "remediation": {
        "type": "string"
      },
      "standards": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "unresolved": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "lineStart",
            "lineEnd",
            "quote"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "lineStart": {
              "type": "integer",
              "minimum": 1
            },
            "lineEnd": {
              "type": "integer",
              "minimum": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "runtimeEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "receiptId",
          "observedImpact",
          "inferredImpact"
        ],
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "receiptId": {
            "type": "string",
            "pattern": "^HTTP-[a-f0-9]{20}$"
          },
          "relatedReceiptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^HTTP-[a-f0-9]{20}$"
            },
            "uniqueItems": true
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "reproducibility": {
            "enum": [
              "single-observation",
              "repeated",
              "differential",
              "state-transition"
            ]
          },
          "observedImpact": {
            "type": "string",
            "minLength": 1
          },
          "inferredImpact": {
            "type": "string"
          }
        }
      }
    }
  },

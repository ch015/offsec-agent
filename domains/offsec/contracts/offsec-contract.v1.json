{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "nunchi.offsec.assessment",
  "version": "1.10.0",
  "executionMode": "host-bounded-workers",
  "leadRole": "offsec-lead",
  "forbiddenModelTools": [
    "Agent"
  ],
  "limits": {
    "maxBudgetUsd": null,
    "maxFeedbackIterations": 2,
    "maxSubagentDepth": 1
  },
  "workUnitPolicy": {
    "minimumSourceFiles": 50,
    "maximumWorkUnits": 128,
    "maximumConcurrency": 16,
    "maxContextFilesPerUnit": 75
  },
  "liveTestPolicy": {
    "interactionModes": [
      "remote-handoff",
      "local-headed-browser",
      "none"
    ],
    "maximumRequests": 1000,
    "maximumResponseBytes": 5242880,
    "maximumTimeoutMs": 60000,
    "maximumStateChanges": 100,
    "maximumDurationMs": 3600000
  },
  "isolation": {
    "settingSources": [],
    "strictMcpConfig": true,
    "disableAutoMemory": true,
    "inheritParentSecrets": false,
    "sandboxRequired": true,
    "networkDefaultDeny": true,
    "permissionMode": "dontAsk",
    "reportGate": "strict"
  },
  "roles": {
    "offsec-lead": {
      "agentFile": "contracts/roles/offsec-lead.md",
      "description": "검증된 단계 산출물을 수렴하고 최종 보고서 초안을 작성하는 판단 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write",
        "mcp__nunchi__submit_finding"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "va-auditor": {
      "agentFile": "contracts/roles/va-auditor.md",
      "description": "8차원 보안 아키텍처 진단과 증거 기반 후보 생성을 담당하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash",
        "Write",
        "mcp__nunchi__submit_finding"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "verifier": {
      "agentFile": "contracts/roles/verifier.md",
      "description": "VA와 분리된 컨텍스트에서 자율 탐색 후 증거를 재검증하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash",
        "Write",
        "mcp__nunchi__submit_finding",
        "mcp__nunchi__submit_objection"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "pentester": {
      "agentFile": "contracts/roles/pentester.md",
      "description": "승인된 범위에서 공격 경로와 POC를 검증하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write",
        "mcp__nunchi__submit_finding",
        "mcp__nunchi__http_probe",
        "mcp__nunchi__propose_live_scenario",
        "mcp__nunchi__execute_live_scenario"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    },
    "redteam-reviewer": {
      "agentFile": "contracts/roles/redteam-reviewer.md",
      "description": "소스와 IaC를 근거로 공격 체인·탐지·복구 공백을 독립 검토하는 역할",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Write",
        "mcp__nunchi__submit_finding"
      ],
      "elevatedTools": [],
      "skills": [
        "nunchi-offsec:offsec-contract"
      ],
      "allowedDelegates": []
    }
  },

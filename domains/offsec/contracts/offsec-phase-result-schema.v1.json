{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "phase",
    "role",
    "status",
    "artifacts",
    "summary",
    "metrics",
    "unresolved"
  ],
  "properties": {
    "contractVersion": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingCount",
        "objectionCount"
      ],
      "properties": {
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "objectionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workUnitKey",
        "workPlanSha256",
        "assignedSourceSha256"
      ],
      "properties": {
        "workUnitKey": {
          "type": "string",
          "pattern": "^unit-[a-f0-9]{16}$"
        },
        "workPlanSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assignedSourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

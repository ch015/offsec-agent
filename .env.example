ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── AI Provider Auth Configuration ──────────────────────────────────
# AUTH_MODE: api_key | oauth
# - api_key: ANTHROPIC_API_KEY를 직접 사용 (API 과금)
# - oauth: Claude Agent SDK의 OAuth profile/구독 계정 사용 (API 키를 subprocess에 전달하지 않음)
# 현재 oauth는 비활성화 — 구독 크레딧 소진 방지를 위해 api_key만 사용
AUTH_MODE=api_key

# ── Model Configuration ─────────────────────────────────────────────
# 기능이 전체 완성될 때까지 최소 비용 모델(haiku)로 셋팅
# 완성 후 opus/sonnet으로 전환
ASSESS_PRIMARY_MODEL=haiku
ASSESS_REVIEW_MODEL=haiku

# 개발 중 primary/review 동일 모델 허용 (프로덕션에서는 제거)
ALLOW_SAME_MODEL=1

# ── 공유 상태 (선택) — PostgreSQL backend로 resume/lease를 쓸 때만 ──────
# NUNCHI_STATE_BACKEND=postgres
# NUNCHI_DATABASE_URL=postgres://user:pass@localhost:5432/nunchi
# NUNCHI_ARTIFACT_ROOT=/absolute/shared/artifact/path
# NUNCHI_SHARED_ENGAGEMENT_ROOT=/absolute/shared/run/path
